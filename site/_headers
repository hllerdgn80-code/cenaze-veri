/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/ayarlar.json
  X-Robots-Tag: noindex

/surum.json
  X-Robots-Tag: noindex

/ezan/*
  X-Robots-Tag: noindex

/indir/*
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment
  Cache-Control: no-cache
